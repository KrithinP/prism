# Copy to .env.local and fill in. .env.local is gitignored — a real key never
# goes in a committed file, not even "just for now".

# Weights & Biases — experiment tracking for the ablation grid
WANDB_API_KEY=
WANDB_PROJECT=prism
WANDB_ENTITY=

